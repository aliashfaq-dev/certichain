PORT=4000
FRONTEND_ORIGIN=http://localhost:5173,https://certichain-lovat.vercel.app
# Backend-only secrets. Never place these in frontend/.env.
PINATA_JWT=

# SMTP account settings for the provider that owns the sender mailbox.
# SMTP_FROM must be an address authorized by that SMTP provider.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CertiChain <certichain.certificate@mail.org>

# MongoDB Atlas connection string for student accounts
MONGO_URI=
# Long random secret used to sign student login sessions (32+ random bytes)
JWT_SECRET=
