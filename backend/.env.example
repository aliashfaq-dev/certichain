PORT=4000
FRONTEND_ORIGIN=http://localhost:5173,https://certichain-lovat.vercel.app
# Add PINATA_JWT in Vercel Project Settings > Environment Variables.
# Keep this secret on the backend only; never put it in frontend/.env.
PINATA_JWT=
# Resend transactional email (requires a verified sender/domain in Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=CertiChain <certificates@your-verified-domain.com>

# MongoDB Atlas connection string for student accounts
MONGODB_URI=
# Long random secret used to sign student login sessions (32+ random bytes)
JWT_SECRET=
